# Obsidian 로컬 에디터 설정
.obsidian/

# Gradle
.gradle/
build/
!sources/gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
# IntelliJ 가 Gradle 에 위임하지 않고 직접 빌드할 때의 산출물 — build/ 와 같은 성격이다.
out/

# 프론트
node_modules/
sources/frontend/dist/

# 로컬 실행
logs/
*.log
# application-local.yml 은 무시하지 않는다 — 템플릿을 받은 사람이 "로컬을 어떻게 띄우나"
# 의 답을 가져야 한다. 비밀값은 그 파일에 두지 않고 환경변수로 주입한다.

# 품질 검사 기준선 — 로컬 측정값이다. 팀이 공유할 값이 아니다.
.quality-baseline.json

# ── 파생 문서 ────────────────────────────────────────────────────────
# **정본이면 커밋하고 파생이면 제외한다.** 정본에서 얼마든지 다시 만들 수 있는 것을
# 커밋에 넣으면, 정본을 한 줄 고칠 때마다 만 줄짜리 파생물이 diff 를 덮어 무엇이
# 바뀌었는지 보이지 않게 된다.
#
# 화면 하나의 정본은 requirements.md 와 manual.md 둘이다.
#   requirements.md ──/mockup──> mockup.html ──/manual-site──> manual.html · 고객사 제출본
# 목업은 요건서의 파생물이라 여기서 뺀다 — 새로 클론한 트리에 없는 것이 정상이고,
# 승인이나 메뉴얼 생성에 필요할 때 만든다.
documents/screen/**/mockup.html
documents/screen/**/manual.html
documents/screen/index.html
build/manual/

# spec YAML 에서 /doc-gen 이 만드는 문서 — 서식은 aidd-guide/artifact/template/generated/ 다.
documents/generated/

# macOS
.DS_Store

# AI 대화 기록 — CLAUDE.md §10. 결론은 documents/ 와 커밋 메시지가 갖는다.
chat-history/
