# 대화 원문에서 가릴 줄을 고르는 규칙 — .claude/hooks/log-raw.mjs 가 읽는다.
#
# 한 줄에 정규식 하나. 대소문자를 가리지 않는다. 빈 줄과 # 로 시작하는 줄은 건너뛴다.
# 걸린 줄은 값만이 아니라 **통째로** ***MASKED*** 가 된다 — 값만 지우면 앞뒤 문맥이
# 그 값을 되살린다.
#
# 이것으로 충분하지 않다. 패턴은 아는 모양만 잡는다 — 애초에 넣지 않는 것이 유일하게
# 확실하다(aidd-guide/harness/memory/logs.md). 규칙을 더할 때는 넓게 잡는다: 가려서 잃는 것은
# 로그 한 줄이고, 못 가려서 잃는 것은 자격증명이다.

# 자격증명 — 이름과 값이 한 줄에 있는 형태
(?:password|passwd|pwd|비밀번호)\s*[:=]
(?:secret|token|api[_-]?key|access[_-]?key|client[_-]?secret)\s*[:=]
authorization\s*:\s*bearer\s

# 자격증명 — 값 자체의 모양
-----BEGIN [A-Z ]*PRIVATE KEY-----
\bgh[pousr]_[A-Za-z0-9]{16,}
\bsk-[A-Za-z0-9_-]{16,}
\bAKIA[0-9A-Z]{16}\b
\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.

# 접속 문자열 — 사용자·비밀번호가 URL 에 실린 형태
\b[a-z][a-z0-9+.-]*://[^\s/@]+:[^\s/@]+@
jdbc:[a-z]+:.*(?:password|user)\s*=

# 개인정보 — 주민등록번호
\b\d{6}\s*-\s*[1-4]\d{6}\b
