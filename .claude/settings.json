{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/session-start.mjs"],
            "timeout": 60,
            "statusMessage": "원격 동기화·프로젝트 상태 확인"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|^mcp__.*__(?:write|edit|move|create)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/aidd-guide/harness/runtime/pretool-bootstrap.mjs", "claude", ".claude/hooks/pre-write.mjs"],
            "timeout": 45,
            "statusMessage": "게이트·산출물 지도 확인"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|^mcp__.*__(?:start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/aidd-guide/harness/runtime/pretool-bootstrap.mjs", "claude", ".claude/hooks/pre-shell.mjs"],
            "timeout": 20,
            "statusMessage": "파괴적 명령·커밋 형태·쓰기 경로 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|^mcp__.*__(?:write|edit|move|create)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/post-write.mjs"],
            "timeout": 90,
            "statusMessage": "인코딩·추적성·문서 현행화"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/log-raw.mjs"],
            "timeout": 10,
            "statusMessage": "대화 기록"
          },
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/context-gauge.mjs"],
            "timeout": 10,
            "statusMessage": "문맥 게이지"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/log-raw.mjs"],
            "timeout": 15,
            "statusMessage": "대화 기록"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/hooks/*)",
      "Bash(node aidd-guide/harness/runtime/*)",
      "Bash(node aidd-guide/meta/_meta/lint.mjs*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
